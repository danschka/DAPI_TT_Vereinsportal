@page "/seite/{Slug}"

@using TT_Website.Models
@using TT_Website.Services
@inject ContentPageService ContentPageService
@inject IWebHostEnvironment Environment

@if (contentPage is null)
{
    <div class="alert alert-warning">Diese Seite ist noch nicht angelegt oder aktuell deaktiviert.</div>
}
else
{
    <header class="plain-page-header">
        <p class="eyebrow">TSV 1883 Bogen Tischtennis</p>
        <h1>@contentPage.Title</h1>
        @if (!string.IsNullOrWhiteSpace(contentPage.Summary)) { <p>@contentPage.Summary</p> }
    </header>

    @if (HasVereinslokalFeatureImages)
    {
        <section class="content-card venue-feature">
            <img class="venue-logo-banner" src="/uploads/vereinslokal/restaurant-bei-anna-logo.jpg" alt="Restaurant bei Anna" />
            <figure class="venue-photo-layout">
                <img src="/uploads/vereinslokal/restaurant-bei-anna-team.jpg" alt="Restaurant bei Anna mit TSV 1883 Bogen Trikot" />
                <figcaption><p class="cms-text-card__question">Wo treffen wir uns neben der Halle?</p><h2>Restaurant bei Anna</h2><p>Unser Treffpunkt für Vereinsleben, Austausch und gemeinsame Abende abseits der Platte.</p></figcaption>
            </figure>
        </section>
    }

    <section class="cms-section-list">
        @foreach (var section in CmsContentParser.Parse(contentPage.Content).Where(x => !x.IsImage))
        {
            <article class="content-card cms-text-card">
                @if (!string.IsNullOrWhiteSpace(section.Heading)) { <p class="cms-text-card__question">@section.Heading</p> }
                <p>@section.Text</p>
            </article>
        }
    </section>

    @if (contentPage.ShowMap)
    {
        <section class="content-card">
            <div class="section-heading"><div><p class="eyebrow">Anfahrt</p><h2>Vereinslokal</h2>@if (!string.IsNullOrWhiteSpace(contentPage.MapAddress)) { <p>@contentPage.MapAddress</p> }</div></div>
            <iframe class="map-embed" src="@GetMapUrl(contentPage)" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
        </section>
    }

    <ContentGalleryGroups Groups="contentPage.GalleryGroups" />
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private ContentPage? contentPage;
    private bool HasVereinslokalFeatureImages => contentPage?.Slug == "vereinslokal"
        && StaticWebFileExists("/uploads/vereinslokal/restaurant-bei-anna-logo.jpg")
        && StaticWebFileExists("/uploads/vereinslokal/restaurant-bei-anna-team.jpg");

    protected override async Task OnParametersSetAsync() => contentPage = await ContentPageService.GetBySlugAsync(Slug);

    private bool StaticWebFileExists(string webPath)
    {
        var webRoot = Path.GetFullPath(Environment.WebRootPath);
        var fullPath = Path.GetFullPath(Path.Combine(webRoot, webPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar)));
        return fullPath.StartsWith(webRoot, StringComparison.OrdinalIgnoreCase) && File.Exists(fullPath);
    }

    private static string GetMapUrl(ContentPage page) => !string.IsNullOrWhiteSpace(page.MapEmbedUrl)
        ? page.MapEmbedUrl
        : $"https://www.google.com/maps?q={Uri.EscapeDataString(page.MapAddress ?? "Bogen Deutschland")}&output=embed";
}
