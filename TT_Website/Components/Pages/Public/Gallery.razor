@page "/gallery"
@page "/archiv"
@using TT_Website.Models
@using TT_Website.Services
@inject GalleryService GalleryService

<EditablePublicPageHeader Slug="galerie" Eyebrow="Galerie" DefaultTitle="Bilderarchiv" DefaultSummary="Öffentliche Bildgruppen aus Training, Spielbetrieb, Aktionen und Vereinsleben." ShowContent="true" />
@if (groups.Count == 0) { <section class="empty-state"><h2>Noch keine Bildgruppen vorhanden</h2><p class="text-muted">Sobald öffentliche Bildgruppen bereitgestellt wurden, erscheinen sie hier.</p></section> }
else { <GalleryGroupWidget Groups="GalleryWidgetGroup.FromGroups(groups)" /> }
@code { private List<GalleryGroup> groups = []; protected override async Task OnInitializedAsync() => groups = await GalleryService.GetPublicGroupsAsync(); }
