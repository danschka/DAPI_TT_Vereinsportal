@page "/"

@using TT_Website.Models
@using TT_Website.Services

@inject NewsService NewsService
@inject GalleryService GalleryService
@inject SponsorService SponsorService
@inject ContentPageService ContentPageService
@inject CalendarEventService CalendarEventService

<div class="preview-home">
    <section class="home-news-stage" aria-label="Aktuelle Meldungen">
        <input id="home-stage-pause" class="home-stage-pause" type="checkbox" />
        <label for="home-stage-pause" class="home-stage-pause-button" title="Animation pausieren"><span class="pause-icon">Ⅱ</span><span class="play-icon">▶</span></label>

        @if (heroNews.Count == 0)
        {
            <div class="home-stage-fallback"><p class="preview-kicker">TSV 1883 Bogen Tischtennis</p><h1>@HomeTitle</h1><p>@HomeSummary</p></div>
        }
        else
        {
            <div class="home-stage-slides">
                @for (var index = 0; index < heroNews.Count; index++)
                {
                    var post = heroNews[index];
                    <article class="home-stage-slide" style="--stage-index:@index">
                        @if (!string.IsNullOrWhiteSpace(post.ImagePath)) { <img src="@post.ImagePath" alt="" /> }
                        <div class="home-stage-shade"></div>
                        <div class="home-stage-copy"><p>@post.CreatedAt.ToString("dd.MM.yyyy") · Vereinsnews</p><h1>@post.Title</h1><a class="home-stage-more" href="@($"/news/{post.Id}")">Mehr</a></div>
                    </article>
                }
            </div>
            <div class="home-stage-tabs">
                @for (var index = 0; index < heroNews.Count; index++)
                {
                    var post = heroNews[index];
                    <a class="home-stage-tab" style="--stage-index:@index" href="@($"/news/{post.Id}")">
                        @if (!string.IsNullOrWhiteSpace(post.ImagePath)) { <img src="@post.ImagePath" alt="" /> }
                        else { <span class="home-stage-tab-logo"><img src="/vereinslogo.png" alt="" /></span> }
                        <strong>@post.Title</strong>
                    </a>
                }
            </div>
        }
    </section>

    <section class="preview-section">
        <div class="preview-section-header">
            <div>
                <p class="preview-kicker">Aktuell</p>
                <h2>Neuigkeiten aus dem Verein</h2>
            </div>
            <a href="/news">Alle News</a>
        </div>

        @if (latestNews.Count == 0)
        {
            <p class="preview-empty">Noch keine News vorhanden.</p>
        }
        else
        {
            <div class="home-news-loop @(latestNews.Count > 3 ? "is-rotating" : "")">
              @foreach (var batch in HomeNewsLoop.Chunk(3))
              {
                <div class="preview-news-grid home-news-batch">
                @foreach (var post in batch)
                {
                    <a class="preview-news-card" href="@($"/news/{post.Id}")">
                        @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                        {
                            <img src="@post.ImagePath" alt="@post.Title" />
                        }
                        <div>
                            <time datetime="@post.CreatedAt.ToString("yyyy-MM-dd")">
                                @post.CreatedAt.ToString("dd.MM.yyyy")
                            </time>
                            <h3>@post.Title</h3>
                            <p>@GetTeaser(post.Content)</p>
                        </div>
                    </a>
                }
                </div>
              }
            </div>
        }
    </section>

    <section class="preview-section preview-split">
        <div>
            <p class="preview-kicker">Training</p>
            <h2>Einsteigen, mitspielen, besser werden.</h2>
            <p>
                Jugend, Erwachsene und freies Training haben feste Zeiten. So finden neue Spielerinnen
                und Spieler schnell den passenden Einstieg.
            </p>
            <a class="btn btn-primary" href="/training">Zum Training</a>
        </div>

        <div class="preview-training-list">
            <div>
                <span>Jugend</span>
                <strong>Mo & Mi, 17:00 - 18:30 Uhr</strong>
            </div>
            <div>
                <span>Erwachsene</span>
                <strong>Mo & Mi, 19:00 - 21:30 Uhr</strong>
            </div>
            <div>
                <span>Freies Training</span>
                <strong>Fr, 18:00 - 21:00 Uhr</strong>
            </div>
        </div>
    </section>

    <section class="preview-section home-calendar-section">
        <div class="preview-section-header">
            <div>
                <p class="preview-kicker">Kalender</p>
                <h2>Die nächsten 7 Tage</h2>
            </div>
        </div>
        <div class="home-calendar-strip" aria-label="Veranstaltungskalender für die nächsten 7 Tage">
            @foreach (var day in CalendarDays)
            {
                var dayEvents = calendarEvents.Where(x => x.EventDate.Date == day).ToList();
                <article class="home-calendar-day @(dayEvents.Count > 0 ? "has-event" : "")">
                    <header>
                        <span>@day.ToString("ddd", GermanCulture)</span>
                        <strong>@day.Day</strong>
                        <small>@day.ToString("MMM", GermanCulture)</small>
                    </header>
                    @if (dayEvents.Count == 0)
                    {
                        <p class="home-calendar-empty">Kein Termin</p>
                    }
                    else
                    {
                        @foreach (var item in dayEvents)
                        {
                            <div class="home-calendar-entry" title="@item.Description">
                                <time>@item.EventDate.ToString("HH:mm")</time>
                                <strong>@item.Title</strong>
                            </div>
                        }
                    }
                </article>
            }
        </div>
    </section>

    <section class="preview-section home-service-grid">
        <article class="home-calendar-card">
            <p class="preview-kicker">Termine</p>
            <h2>Was als Nächstes ansteht</h2>
            @if (nextEvent is null)
            {
                <p>Aktuell ist noch keine kommende Veranstaltung eingetragen.</p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(nextEvent.ImagePath))
                {
                    <img class="home-next-event-image" src="@nextEvent.ImagePath" alt="@nextEvent.Title" />
                }
                <time class="home-next-event-date" datetime="@nextEvent.EventDate.ToString("s")">
                    @nextEvent.EventDate.ToString("dddd, dd. MMMM yyyy · HH:mm", GermanCulture) Uhr
                </time>
                <h3>@nextEvent.Title</h3>
                <p>@nextEvent.Description</p>
            }
        </article>
        <article class="home-links-card">
            <p class="preview-kicker">Spielbetrieb</p>
            <h2>Direkt zu den Ergebnissen</h2>
            <div class="home-link-list">
                <a href="/mannschaften"><span>Mannschaften</span><strong>→</strong></a>
                <a href="/vereinsrangliste"><span>Vereinsrangliste</span><strong>→</strong></a>
                <a href="https://www.mytischtennis.de/" target="_blank" rel="noopener"><span>myTischtennis</span><strong>↗</strong></a>
                <a href="https://www.bttv.de/click-tt" target="_blank" rel="noopener"><span>Click-TT</span><strong>↗</strong></a>
            </div>
        </article>
    </section>

    <section class="preview-section">
        <div class="preview-section-header">
            <div>
                <p class="preview-kicker">Galerie</p>
                <h2>Momente aus Halle und Vereinsleben</h2>
            </div>
            <a href="/gallery">Zur Galerie</a>
        </div>

        @if (galleryGroups.Count == 0)
        {
            <p class="preview-empty">Noch keine öffentlichen Bildgruppen vorhanden.</p>
        }
        else
        {
            <GalleryGroupWidget Groups="GalleryWidgetGroup.FromGroups(galleryGroups)" />
        }
    </section>

    <section class="preview-section preview-sponsors">
        <div class="preview-section-header">
            <div>
                <p class="preview-kicker">Partner</p>
                <h2>Unterstützer des Vereins</h2>
            </div>
        </div>

        @if (sponsors.Count == 0)
        {
            <p class="preview-empty">Noch keine Sponsoren vorhanden.</p>
        }
        else
        {
            <div class="preview-sponsor-marquee" aria-label="Unterstützer des Vereins">
                <div class="preview-sponsor-track">
                    @foreach (var sponsor in GetSponsorLoop())
                    {
                        <a class="preview-sponsor-logo"
                           href="@GetSponsorUrl(sponsor)"
                           target="@GetSponsorTarget(sponsor)"
                           rel="@GetSponsorRel(sponsor)"
                           aria-label="@sponsor.Name">
                            @if (!string.IsNullOrWhiteSpace(sponsor.LogoPath))
                            {
                                <img src="@sponsor.LogoPath" alt="@sponsor.Name" />
                            }
                            else
                            {
                                <strong>@sponsor.Name</strong>
                            }
                        </a>
                    }
                </div>
            </div>
        }
    </section>
</div>

@code {
    private List<NewsPost> latestNews = new();
    private List<NewsPost> heroNews = new();
    private List<GalleryGroup> galleryGroups = new();
    private List<Sponsor> sponsors = new();
    private ContentPage? homePage;
    private List<CalendarEvent> calendarEvents = [];
    private CalendarEvent? nextEvent;
    private static readonly System.Globalization.CultureInfo GermanCulture = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    private IEnumerable<DateTime> CalendarDays => Enumerable.Range(0, 7).Select(offset => DateTime.Today.AddDays(offset));
    private IReadOnlyList<NewsPost> HomeNewsLoop
    {
        get
        {
            if (latestNews.Count <= 3) return latestNews;

            var result = new List<NewsPost>(9);
            for (var index = 0; index < 9; index++)
            {
                result.Add(latestNews[index % latestNews.Count]);
            }

            return result;
        }
    }
    private string HomeTitle => string.IsNullOrWhiteSpace(homePage?.Title)
        ? "Training, Teamgeist und Punktspiele an einem Ort."
        : homePage.Title;
    private string HomeSummary => string.IsNullOrWhiteSpace(homePage?.Summary)
        ? "Aktuelle News, Trainingszeiten, Mannschaftsdaten und der schnelle Weg zur Mitgliedschaft für alle, die Tischtennis spielen oder den Verein kennenlernen möchten."
        : homePage.Summary;

    protected override async Task OnInitializedAsync()
    {
        homePage = await ContentPageService.GetBySlugAsync("startseite");
        latestNews = await NewsService.GetLatestAsync(9);
        heroNews = BuildHeroLoop(latestNews);
        galleryGroups = await GalleryService.GetPublicGroupsAsync(8);
        sponsors = await SponsorService.GetActiveAsync();
        calendarEvents = await CalendarEventService.GetUpcomingAsync(DateTime.Today, DateTime.Today.AddDays(6));
        nextEvent = await CalendarEventService.GetNextAsync(DateTime.Now);
    }

    private static List<NewsPost> BuildHeroLoop(IReadOnlyList<NewsPost> posts)
    {
        var source = posts.Take(4).ToList();
        if (source.Count == 0) return [];
        var result = new List<NewsPost>(4);
        for (var index = 0; index < 4; index++) result.Add(source[index % source.Count]);
        return result;
    }

    private static string GetTeaser(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "Mehr Informationen folgen in Kürze.";
        }

        return text.Length <= 140 ? text : $"{text[..137]}...";
    }

    private IEnumerable<Sponsor> GetSponsorLoop()
    {
        return sponsors.Concat(sponsors);
    }

    private static string GetSponsorUrl(Sponsor sponsor)
    {
        return string.IsNullOrWhiteSpace(sponsor.WebsiteUrl) ? "#" : sponsor.WebsiteUrl;
    }

    private static string? GetSponsorTarget(Sponsor sponsor)
    {
        return string.IsNullOrWhiteSpace(sponsor.WebsiteUrl) ? null : "_blank";
    }

    private static string? GetSponsorRel(Sponsor sponsor)
    {
        return string.IsNullOrWhiteSpace(sponsor.WebsiteUrl) ? null : "noopener noreferrer";
    }
}
