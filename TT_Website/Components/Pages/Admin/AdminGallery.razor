@page "/admin/gallery"
@rendermode InteractiveServer

@using TT_Website.Models
@using TT_Website.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.IO.Compression

@inject GalleryService GalleryService
@inject FileUploadService FileUploadService

<section class="admin-page-header">
    <div>
        <p class="eyebrow">Galerie</p>
        <h1>Galerie verwalten</h1>
        <p class="text-muted">Bildgruppen, Slideshow-Zuweisungen und hochgeladene Bilder organisieren.</p>
    </div>
    <a class="btn btn-primary" href="/admin/gallery-upload">Neues Bild hochladen</a>
</section>

<section class="content-card form-card bulk-upload-card">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Sammelimport</p>
            <h2>Ordner oder ZIP hochladen</h2>
        </div>
    </div>
    <p class="text-muted">Wähle einen ganzen Bilderordner, mehrere Bilder oder eine ZIP-Datei. Maximal 500 Bilder, je Bild 10 MB.</p>

    <div class="bulk-upload-grid">
        <div>
            <label class="form-label">Bilderordner / mehrere Bilder</label>
            <InputFile @key="bulkUploadInputKey" class="form-control" multiple webkitdirectory accept="image/jpeg,image/png,image/webp,image/gif" OnChange="HandleBulkFilesSelected" />
            @if (bulkFiles.Count > 0)
            {
                <small>@bulkFiles.Count Bilddatei(en) ausgewählt</small>
            }
        </div>
        <div>
            <label class="form-label">ZIP-Datei</label>
            <InputFile @key="zipUploadInputKey" class="form-control" accept=".zip,application/zip" OnChange="HandleZipSelected" />
            @if (zipFile is not null)
            {
                <small>@zipFile.Name ausgewählt</small>
            }
        </div>
    </div>

    <button class="btn btn-primary" type="button" disabled="@isBulkUploading" @onclick="ImportSelectedFiles">
        @(isBulkUploading ? "Bilder werden importiert …" : "Auswahl importieren")
    </button>
</section>

@if (showGroupDialog)
{
    <div class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="bulk-group-title">
        <button class="admin-dialog__backdrop" type="button" aria-label="Dialog schließen" @onclick="FinishWithoutGroup"></button>
        <section class="admin-dialog__panel">
            <p class="eyebrow">Import abgeschlossen</p>
            <h2 id="bulk-group-title">Als Bildgruppe anlegen?</h2>
            <p>@importedImageIds.Count Bilder wurden importiert. Du kannst sie jetzt direkt in einer neuen Bildgruppe zusammenfassen.</p>
            <label class="form-label">Name der Bildgruppe</label>
            <InputText class="form-control" @bind-Value="importGroupName" placeholder="z. B. Vereinsmeisterschaft 2026" />
            <label class="form-check admin-check">
                <InputCheckbox class="form-check-input" @bind-Value="importGroupIsPublic" />
                <span>Im öffentlichen Archiv anzeigen</span>
            </label>
            @if (!string.IsNullOrWhiteSpace(dialogMessage))
            {
                <p class="text-danger">@dialogMessage</p>
            }
            <div class="button-row">
                <button class="btn btn-primary" type="button" @onclick="CreateGroupFromImport">Bildgruppe anlegen</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="FinishWithoutGroup">Nein, nur Bilder speichern</button>
            </div>
        </section>
    </div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass">@message</div>
}

<section class="content-card form-card">
    <h2>Bild hochladen</h2>

    <label class="form-label">Titel</label>
    <InputText class="form-control" @bind-Value="uploadTitle" placeholder="Titel" />

    <label class="form-label">Bilddatei</label>
    <InputFile @key="galleryUploadInputKey" class="form-control" OnChange="HandleGalleryUploadSelected" />

    <label class="form-label">Optional direkt einer Gruppe hinzufügen</label>
    <select class="form-select" @bind="uploadGroupId">
        <option value="0">Keine Gruppe</option>
        @foreach (var group in groups)
        {
            <option value="@group.Id">@group.Name</option>
        }
    </select>

    <div class="button-row">
        <button class="btn btn-primary" type="button" @onclick="UploadGalleryImage">
            Bild hochladen
        </button>
        <a class="btn btn-outline-primary" href="/admin/gallery-upload">Upload-Seite öffnen</a>
    </div>
</section>

<section class="content-card form-card">
    <h2>@(editingGroupId.HasValue ? "Gruppe bearbeiten" : "Neue Gruppe")</h2>

    <label class="form-label">Gruppenname</label>
    <InputText class="form-control" @bind-Value="groupName" placeholder="Gruppenname, z. B. Weihnachtsmarkt" />

    <label class="form-label">Beschreibung</label>
    <InputTextArea class="form-control" @bind-Value="groupDescription" placeholder="Beschreibung optional" />

    <label class="form-check admin-check">
        <InputCheckbox class="form-check-input" @bind-Value="groupIsPublic" />
        <span>Im öffentlichen Archiv anzeigen</span>
    </label>
    <small class="text-muted">Deaktivierte Bildgruppen sind nur im Mitgliederbereich sichtbar.</small>

    @if (!editingGroupId.HasValue)
    {
        <label class="form-label">Optional erstes Bild</label>
        <select class="form-select" @bind="newGroupImageId">
            <option value="0">Kein Bild</option>
            @foreach (var image in images)
            {
                <option value="@image.Id">@image.Title</option>
            }
        </select>
    }

    <div class="button-row">
        <button class="btn btn-primary" type="button" @onclick="SaveGroup">
            @(editingGroupId.HasValue ? "Gruppe speichern" : "Gruppe anlegen")
        </button>

        @if (editingGroupId.HasValue)
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="CancelGroupEdit">
                Abbrechen
            </button>
        }
    </div>
</section>

<section class="content-card">
    <div class="section-heading">
        <div>
            <h2>Gruppen</h2>
            <span>@groups.Count Gruppe@(groups.Count == 1 ? "" : "n")</span>
        </div>
    </div>

    @if (groups.Count == 0)
    {
        <p class="text-muted">Noch keine Gruppen vorhanden.</p>
    }
    else
    {
        <div class="admin-group-list">
            @foreach (var group in groups)
            {
                <section class="admin-gallery-group" @key="group.Id">
                    <div class="admin-gallery-group__header">
                        <div>
                            <h3>@group.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(group.Description))
                            {
                                <p class="text-muted">@group.Description</p>
                            }
                            <span class="badge bg-secondary">@group.Images.Count Bild@(group.Images.Count == 1 ? "" : "er")</span>
                            <span class="badge @(group.IsPublic ? "bg-success" : "bg-dark")">@(group.IsPublic ? "Im Archiv" : "Nur Mitglieder")</span>
                        </div>

                        <div class="button-row">
                            <button class="btn btn-outline-primary" type="button" @onclick="() => StartGroupEdit(group)">
                                Bearbeiten
                            </button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => DeleteGroup(group.Id)">
                                Löschen
                            </button>
                        </div>
                    </div>

                    <div class="admin-inline-form">
                        <select class="form-select"
                                value="@GetSelectedImageId(group.Id)"
                                @onchange="eventArgs => SetSelectedImageId(group.Id, eventArgs)">
                            <option value="0">Bild auswählen</option>
                            @foreach (var image in images)
                            {
                                <option value="@image.Id">@image.Title</option>
                            }
                        </select>
                        <button class="btn btn-primary" type="button" @onclick="() => AddImageToGroup(group.Id)">
                            Bild hinzufügen
                        </button>
                    </div>

                    @if (group.Images.Count > 0)
                    {
                        <div class="admin-gallery-grid">
                            @foreach (var groupImage in group.Images.OrderBy(x => x.SortOrder))
                            {
                                if (groupImage.GalleryImage != null)
                                {
                                    <div class="admin-gallery-card">
                                        <img src="@groupImage.GalleryImage.ImagePath" alt="@groupImage.GalleryImage.Title" />
                                        <h4>@groupImage.GalleryImage.Title</h4>
                                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => RemoveImageFromGroup(groupImage.Id)">
                                            Aus Gruppe entfernen
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
</section>

<section class="content-card">
    <div class="section-heading">
        <div>
            <h2>Alle Bilder</h2>
            <span>@images.Count Bild@(images.Count == 1 ? "" : "er")</span>
        </div>
    </div>

    @if (images.Count == 0)
    {
        <p class="text-muted">Keine Bilder vorhanden.</p>
    }
    else
    {
        <div class="admin-gallery-grid">
            @foreach (var image in images)
            {
                <div class="admin-gallery-card">
                    <img src="@image.ImagePath" alt="@image.Title" />
                    <h4>@image.Title</h4>
                    <p class="text-muted">@image.UploadedAt.ToString("dd.MM.yyyy HH:mm")</p>

                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => DeleteImage(image)">
                        Löschen
                    </button>
                </div>
            }
        </div>
    }
</section>

@code {
    private List<GalleryImage> images = [];
    private List<GalleryGroup> groups = [];
    private Dictionary<int, int> selectedImageIds = [];
    private IBrowserFile? uploadFile;
    private string uploadTitle = "";
    private int uploadGroupId;
    private int galleryUploadInputKey;
    private IReadOnlyList<IBrowserFile> bulkFiles = [];
    private IBrowserFile? zipFile;
    private int bulkUploadInputKey;
    private int zipUploadInputKey;
    private bool isBulkUploading;
    private bool showGroupDialog;
    private List<int> importedImageIds = [];
    private string importGroupName = "";
    private bool importGroupIsPublic = true;
    private string dialogMessage = "";

    private string groupName = "";
    private string? groupDescription;
    private bool groupIsPublic = true;
    private int? editingGroupId;
    private int newGroupImageId;

    private string message = "";
    private string messageClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        images = await GalleryService.GetAllAsync();
        groups = await GalleryService.GetGroupsAsync();
        var validGroupIds = groups.Select(x => x.Id).ToHashSet();
        foreach (var groupId in selectedImageIds.Keys.Where(groupId => !validGroupIds.Contains(groupId)).ToList())
        {
            selectedImageIds.Remove(groupId);
        }

        foreach (var group in groups)
        {
            selectedImageIds.TryAdd(group.Id, 0);
        }

        if (uploadGroupId > 0 && !validGroupIds.Contains(uploadGroupId))
            uploadGroupId = 0;
    }

    private void HandleGalleryUploadSelected(InputFileChangeEventArgs e)
    {
        uploadFile = e.File;

        if (string.IsNullOrWhiteSpace(uploadTitle))
            uploadTitle = Path.GetFileNameWithoutExtension(e.File.Name);
    }

    private void HandleBulkFilesSelected(InputFileChangeEventArgs e)
    {
        bulkFiles = e.GetMultipleFiles(500)
            .Where(file => FileUploadService.IsAllowedImageFileName(file.Name))
            .ToList();
        zipFile = null;
        zipUploadInputKey++;
    }

    private void HandleZipSelected(InputFileChangeEventArgs e)
    {
        zipFile = e.File;
        bulkFiles = [];
        bulkUploadInputKey++;
    }

    private async Task ImportSelectedFiles()
    {
        if (bulkFiles.Count == 0 && zipFile is null)
        {
            SetMessage("Bitte einen Bilderordner, mehrere Bilder oder eine ZIP-Datei auswählen.", "alert-warning");
            return;
        }

        isBulkUploading = true;
        importedImageIds = [];
        var savedPaths = new List<string>();

        try
        {
            if (zipFile is not null)
                await ImportZip(zipFile, savedPaths);
            else
                await ImportBrowserFiles(savedPaths);

            if (importedImageIds.Count == 0)
                throw new InvalidOperationException("In der Auswahl wurden keine unterstützten Bilder gefunden.");

            importGroupName = zipFile is not null
                ? Path.GetFileNameWithoutExtension(zipFile.Name)
                : "Neue Bildgruppe";
            dialogMessage = "";
            showGroupDialog = true;
            SetMessage($"{importedImageIds.Count} Bilder wurden erfolgreich importiert.", "alert-success");
            await LoadData();
        }
        catch (Exception ex)
        {
            foreach (var path in savedPaths)
                FileUploadService.DeleteIfExists(path);
            foreach (var imageId in importedImageIds)
                await GalleryService.DeleteAsync(imageId);
            importedImageIds = [];
            SetMessage($"Import fehlgeschlagen: {ex.Message}", "alert-danger");
        }
        finally
        {
            isBulkUploading = false;
        }
    }

    private async Task ImportBrowserFiles(List<string> savedPaths)
    {
        foreach (var file in bulkFiles)
        {
            var path = await FileUploadService.SaveAsync(file, "gallery", UploadFileKind.Image, 10 * 1024 * 1024);
            savedPaths.Add(path);
            var image = await GalleryService.AddAsync(new GalleryImage
            {
                Title = Path.GetFileNameWithoutExtension(file.Name),
                ImagePath = path,
                UploadedAt = DateTime.Now
            });
            importedImageIds.Add(image.Id);
        }
    }

    private async Task ImportZip(IBrowserFile file, List<string> savedPaths)
    {
        const long maxZipSize = 250L * 1024 * 1024;
        const long maxImageSize = 10L * 1024 * 1024;
        await using var source = file.OpenReadStream(maxZipSize);
        using var archive = new ZipArchive(source, ZipArchiveMode.Read, leaveOpen: false);
        var entries = archive.Entries
            .Where(entry => !string.IsNullOrWhiteSpace(entry.Name) && FileUploadService.IsAllowedImageFileName(entry.Name))
            .Take(501)
            .ToList();

        if (entries.Count > 500)
            throw new InvalidOperationException("Eine ZIP-Datei darf maximal 500 Bilder enthalten.");

        var totalSize = entries.Sum(entry => entry.Length);
        if (totalSize > maxZipSize)
            throw new InvalidOperationException("Die entpackten Bilder sind zusammen größer als 250 MB.");

        foreach (var entry in entries)
        {
            await using var entryStream = entry.Open();
            var path = await FileUploadService.SaveImageStreamAsync(entryStream, entry.Name, "gallery", entry.Length, maxImageSize);
            savedPaths.Add(path);
            var image = await GalleryService.AddAsync(new GalleryImage
            {
                Title = Path.GetFileNameWithoutExtension(entry.Name),
                ImagePath = path,
                UploadedAt = DateTime.Now
            });
            importedImageIds.Add(image.Id);
        }
    }

    private async Task CreateGroupFromImport()
    {
        if (string.IsNullOrWhiteSpace(importGroupName))
        {
            dialogMessage = "Bitte einen Namen für die Bildgruppe eingeben.";
            return;
        }

        var group = await GalleryService.AddGroupAsync(new GalleryGroup
        {
            Name = importGroupName.Trim(),
            Description = $"Sammelimport vom {DateTime.Now:dd.MM.yyyy}",
            IsPublic = importGroupIsPublic
        });

        foreach (var imageId in importedImageIds)
            await GalleryService.AddImageToGroupAsync(group.Id, imageId);

        SetMessage($"Die Bildgruppe „{group.Name}“ wurde mit {importedImageIds.Count} Bildern angelegt.", "alert-success");
        await FinishImportDialog();
    }

    private async Task FinishWithoutGroup() => await FinishImportDialog();

    private async Task FinishImportDialog()
    {
        showGroupDialog = false;
        importedImageIds = [];
        importGroupName = "";
        importGroupIsPublic = true;
        dialogMessage = "";
        bulkFiles = [];
        zipFile = null;
        bulkUploadInputKey++;
        zipUploadInputKey++;
        await LoadData();
    }

    private async Task UploadGalleryImage()
    {
        try
        {
            if (uploadFile is null)
            {
                SetMessage("Bitte ein Bild auswählen.", "alert-warning");
                return;
            }

            if (string.IsNullOrWhiteSpace(uploadTitle))
            {
                SetMessage("Bitte einen Titel für das Bild eingeben.", "alert-warning");
                return;
            }

            var imagePath = await FileUploadService.SaveAsync(
                uploadFile,
                "gallery",
                UploadFileKind.Image,
                10 * 1024 * 1024);

            var image = await GalleryService.AddAsync(new GalleryImage
            {
                Title = uploadTitle.Trim(),
                ImagePath = imagePath,
                UploadedAt = DateTime.Now
            });

            if (uploadGroupId > 0)
            {
                var addResult = await GalleryService.AddImageToGroupAsync(uploadGroupId, image.Id);
                SetMessage(
                    addResult.Success
                        ? "Bild wurde hochgeladen und der Gruppe hinzugefügt."
                        : $"Bild wurde hochgeladen. {addResult.Message}",
                    addResult.Success ? "alert-success" : "alert-warning");
            }
            else
            {
                SetMessage("Bild wurde hochgeladen.", "alert-success");
            }

            uploadFile = null;
            uploadTitle = "";
            uploadGroupId = 0;
            galleryUploadInputKey++;
            await LoadData();
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, "alert-danger");
        }
    }

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(groupName))
        {
            SetMessage("Bitte einen Gruppennamen eingeben.", "alert-warning");
            return;
        }

        if (editingGroupId.HasValue)
        {
            var group = await GalleryService.GetGroupByIdAsync(editingGroupId.Value);

            if (group != null)
            {
                group.Name = groupName.Trim();
                group.Description = groupDescription?.Trim();
                group.IsPublic = groupIsPublic;
                await GalleryService.UpdateGroupAsync(group);
                SetMessage("Gruppe wurde aktualisiert.", "alert-success");
            }
        }
        else
        {
            var createdGroup = await GalleryService.AddGroupAsync(new GalleryGroup
            {
                Name = groupName.Trim(),
                Description = groupDescription?.Trim(),
                IsPublic = groupIsPublic
            });

            if (newGroupImageId > 0)
            {
                var result = await GalleryService.AddImageToGroupAsync(createdGroup.Id, newGroupImageId);
                SetMessage(
                    result.Success ? "Gruppe wurde angelegt und das Bild wurde hinzugefügt." : $"Gruppe wurde angelegt. {result.Message}",
                    result.Success ? "alert-success" : "alert-warning");
            }
            else
            {
                SetMessage("Gruppe wurde angelegt.", "alert-success");
            }
        }

        ResetGroupForm();
        await LoadData();
    }

    private void StartGroupEdit(GalleryGroup group)
    {
        editingGroupId = group.Id;
        groupName = group.Name;
        groupDescription = group.Description;
        groupIsPublic = group.IsPublic;
        SetMessage($"Bearbeite Gruppe '{group.Name}'.", "alert-info");
    }

    private void CancelGroupEdit()
    {
        ResetGroupForm();
        SetMessage("Bearbeitung abgebrochen.", "alert-info");
    }

    private async Task DeleteGroup(int groupId)
    {
        await GalleryService.DeleteGroupAsync(groupId);
        SetMessage("Gruppe wurde gelöscht.", "alert-info");
        await LoadData();
    }

    private async Task AddImageToGroup(int groupId)
    {
        var imageId = selectedImageIds.GetValueOrDefault(groupId);

        if (imageId <= 0)
        {
            SetMessage("Bitte ein Bild auswählen.", "alert-warning");
            return;
        }

        var result = await GalleryService.AddImageToGroupAsync(groupId, imageId);
        selectedImageIds[groupId] = 0;

        SetMessage(result.Message, result.Success ? "alert-success" : "alert-info");

        await LoadData();
    }

    private int GetSelectedImageId(int groupId)
    {
        return selectedImageIds.GetValueOrDefault(groupId);
    }

    private void SetSelectedImageId(int groupId, ChangeEventArgs eventArgs)
    {
        if (int.TryParse(eventArgs.Value?.ToString(), out var imageId))
            selectedImageIds[groupId] = imageId;
        else
            selectedImageIds[groupId] = 0;
    }

    private async Task RemoveImageFromGroup(int groupImageId)
    {
        await GalleryService.RemoveImageFromGroupAsync(groupImageId);
        SetMessage("Bild wurde aus der Gruppe entfernt.", "alert-info");
        await LoadData();
    }

    private async Task DeleteImage(GalleryImage image)
    {
        FileUploadService.DeleteIfExists(image.ImagePath);
        await GalleryService.DeleteAsync(image.Id);

        SetMessage("Bild wurde gelöscht.", "alert-info");
        await LoadData();
    }

    private void ResetGroupForm()
    {
        groupName = "";
        groupDescription = null;
        groupIsPublic = true;
        editingGroupId = null;
        newGroupImageId = 0;
    }

    private void SetMessage(string value, string cssClass)
    {
        message = value;
        messageClass = cssClass;
    }
}
