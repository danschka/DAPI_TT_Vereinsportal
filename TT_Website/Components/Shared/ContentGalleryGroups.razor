@using TT_Website.Models
@if (GalleryGroups.Count > 0) { <section class="content-gallery"><GalleryGroupWidget Groups="GalleryWidgetGroup.FromGroups(GalleryGroups)" /></section> }
@code {
    [Parameter] public IReadOnlyList<ContentPageGalleryGroup> Groups { get; set; } = [];
    private List<GalleryGroup> GalleryGroups => Groups.OrderBy(x => x.SortOrder).Where(x => x.GalleryGroup is not null).Select(x => x.GalleryGroup!).ToList();
}
