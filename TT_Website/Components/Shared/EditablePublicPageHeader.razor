@using TT_Website.Models
@using TT_Website.Services
@inject ContentPageService ContentPageService

@if (RenderHero)
{
    <header class="plain-page-header @CssClass">
        <p class="eyebrow">@Eyebrow</p>
        <h1>@TitleText</h1>
        @if (!string.IsNullOrWhiteSpace(SummaryText)) { <p>@SummaryText</p> }
    </header>
}

@if (ShowContent)
{
    var sections = CmsContentParser.Parse(page?.Content).Where(x => !x.IsImage);
    @if (sections.Any())
    {
        <section class="cms-section-list">
            @foreach (var section in sections)
            {
                <article class="content-card cms-text-card">
                    @if (!string.IsNullOrWhiteSpace(section.Heading)) { <p class="cms-text-card__question">@section.Heading</p> }
                    <p>@section.Text</p>
                </article>
            }
        </section>
    }
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter] public string Eyebrow { get; set; } = "";
    [Parameter] public string DefaultTitle { get; set; } = "";
    [Parameter] public string? DefaultSummary { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public bool ShowContent { get; set; }
    [Parameter] public bool RenderHero { get; set; } = true;

    private ContentPage? page;
    private string TitleText => string.IsNullOrWhiteSpace(page?.Title) ? DefaultTitle : page.Title;
    private string? SummaryText => string.IsNullOrWhiteSpace(page?.Summary) ? DefaultSummary : page.Summary;

    protected override async Task OnParametersSetAsync() => page = string.IsNullOrWhiteSpace(Slug)
        ? null
        : await ContentPageService.GetBySlugAsync(Slug);
}
