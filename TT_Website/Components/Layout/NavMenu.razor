@using TT_Website.Models
@using TT_Website.Services
@rendermode InteractiveServer

@inject ContentPageService ContentPageService
@inject NewsService NewsService

<header class="club-header">
    <div class="club-header__top">
        <a class="club-brand" href="/" aria-label="TSV 1883 Bogen Tischtennis – Startseite">
            <img src="/vereinslogo.png" alt="TSV 1883 Bogen Tischtennis" />
            <span><strong>TSV 1883 Bogen</strong><small>Tischtennis</small></span>
        </a>

        <div class="club-header__actions">
            <details class="club-search" ontoggle="syncClubSearch(this)">
                <summary class="club-login club-search__trigger" aria-label="Vereinsnews durchsuchen">
                    <svg class="club-search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
                    <span class="club-search__label">Suche</span>
                    <span class="club-search__close" aria-hidden="true">×</span>
                </summary>
                <div class="club-search__panel">
                    <input class="club-search__input" type="search" autocomplete="off" @bind="searchQuery" @bind:event="oninput" placeholder="Wonach suchst du?" aria-label="Vereinsnews durchsuchen" />
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <div class="club-search__results">
                            <p class="club-search__result-heading">Suchergebnisse</p>
                            @foreach (var post in SearchResults)
                            {
                                <a href="@($"/news/{post.Id}")" onclick="closeClubNavigation()">
                                    @if (!string.IsNullOrWhiteSpace(post.ImagePath)) { <img src="@post.ImagePath" alt="" /> }
                                    <span><small>@post.CreatedAt.ToString("dd.MM.yyyy") · Vereinsnews</small><strong>@post.Title</strong></span>
                                </a>
                            }
                            @if (SearchResults.Count == 0) { <p class="club-search__empty">Keine Vereinsnews gefunden.</p> }
                        </div>
                    }
                </div>
            </details>
            <a class="club-join" href="/mitglied-werden">Mitglied werden</a>
            <a class="club-login" href="/mitglieder/login">Mitglied Login</a>
            <AuthorizeView>
                <Authorized>
                    <a class="club-login" href="/admin">Admin</a>
                    <form method="post" action="/admin/auth/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="club-login">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized><a class="club-login" href="/admin/login">Admin Login</a></NotAuthorized>
            </AuthorizeView>
        </div>

        <input id="site-nav-toggle" type="checkbox" class="site-nav-toggle" />
        <label for="site-nav-toggle" class="site-nav-button" aria-label="Navigation öffnen">
            <span></span><span></span><span></span>
        </label>
    </div>

    <nav class="club-nav" aria-label="Hauptnavigation">
        <div class="club-nav__inner">
            <a class="club-nav__compact-brand" href="/" aria-label="TSV 1883 Bogen Tischtennis – Startseite" onclick="closeClubNavigation()">
                <img src="/vereinslogo.png" alt="" />
            </a>
            @foreach (var item in navigation)
            {
                <div class="club-nav__item">
                    @if (item.External)
                    {
                        <a class="club-nav__link" href="@item.Url" target="_blank" rel="noopener noreferrer" onclick="closeClubNavigation()">@item.Title</a>
                    }
                    else
                    {
                        <NavLink class="club-nav__link" href="@item.Url" Match="NavLinkMatch.Prefix" onclick="closeClubNavigation()">@item.Title</NavLink>
                    }

                    @if (item.Children.Count > 0)
                    {
                        <div class="club-nav__dropdown">
                            @foreach (var child in item.Children)
                            {
                                <a href="@child.Url" target="@(child.External ? "_blank" : null)" rel="@(child.External ? "noopener noreferrer" : null)" onclick="closeClubNavigation()">@child.Title</a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </nav>
</header>

@code {
    private List<NavigationItem> navigation = [];
    private List<NewsPost> searchNews = [];
    private string searchQuery = "";
    private List<NewsPost> SearchResults => string.IsNullOrWhiteSpace(searchQuery) ? [] : searchNews
        .Where(x => x.Title.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) || x.Content.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase))
        .Take(6).ToList();

    protected override async Task OnInitializedAsync()
    {
        var pages = await ContentPageService.GetNavigationAsync();
        searchNews = await NewsService.GetPublishedAsync();
        var bySlug = pages.ToDictionary(x => x.Slug, StringComparer.OrdinalIgnoreCase);

        navigation =
        [
            new("News", "/news"),
            FromPage(bySlug, "ueber-uns", "Über uns", "/seite/ueber-uns", [
                new("Mitgliedschaft", "/seite/mitgliedschaft"),
                new("Mitglied werden", "/mitglied-werden"),
                new("Kontakt", "/kontakt")
            ]),
            new("Training", "/training"),
            FromPage(bySlug, "jugendarbeit", "Jugendarbeit", "/seite/jugendarbeit"),
            new("Mannschaften", "/mannschaften"),
            FromPage(bySlug, "aktionen", "Aktionen", "/seite/aktionen"),
            FromPage(bySlug, "auszeichnungen", "Auszeichnungen", "/seite/auszeichnungen"),
            new("Tischtennis TV", "/seite/tischtennis-tv"),
            FromPage(bySlug, "webshop", "Webshop", "https://de.butterfly.tt/", external: true),
            new("Archiv", "/archiv")
        ];
    }

    private static NavigationItem FromPage(
        IReadOnlyDictionary<string, ContentPage> pages,
        string slug,
        string title,
        string fallbackUrl,
        List<NavigationItem>? additionalChildren = null,
        bool external = false)
    {
        if (!pages.TryGetValue(slug, out var page))
            return new(title, fallbackUrl, external, additionalChildren ?? []);

        var children = page.Children
            .OrderBy(x => x.SortOrder)
            .Select(x => new NavigationItem(x.Title, GetPageUrl(x), !string.IsNullOrWhiteSpace(x.ExternalUrl)))
            .ToList();
        if (additionalChildren is not null)
            children.AddRange(additionalChildren.Where(x => children.All(y => y.Url != x.Url)));

        return new(page.Title, GetPageUrl(page), !string.IsNullOrWhiteSpace(page.ExternalUrl), children);
    }

    private static string GetPageUrl(ContentPage page) => !string.IsNullOrWhiteSpace(page.ExternalUrl)
        ? page.ExternalUrl
        : page.Slug switch
        {
            "mannschaften-cms" or "mannschaftsuebersicht" => "/mannschaften",
            "aufnahmeerklaerung" => "/mitglied-werden",
            "stammdatenaenderung" => "/stammdatenaenderung",
            "mitgliederentwicklung" => "/mitgliederentwicklung",
            "vereinsrangliste" => "/vereinsrangliste",
            "dokumente" => "/downloads",
            "training" => "/training",
            "news" => "/news",
            "kontakt" => "/kontakt",
            "archiv" or "galerie" => "/archiv",
            _ => $"/seite/{page.Slug}"
        };

    private sealed record NavigationItem(string Title, string Url, bool External = false, List<NavigationItem>? ChildItems = null)
    {
        public List<NavigationItem> Children => ChildItems ?? [];
    }
}
