@inherits LayoutComponentBase

<div class="site-shell">
    <NavMenu />

    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <footer class="club-footer">
        <div class="club-footer__main">
            <div class="club-footer__brand">
                <img src="/vereinslogo.png" alt="" />
                <div><strong>TSV 1883 Bogen</strong><span>Tischtennis</span></div>
            </div>
            <nav aria-label="Footer-Navigation">
                <a href="/news">News</a><a href="/training">Training</a>
                <a href="/mannschaften">Mannschaften</a><a href="/kontakt">Kontakt</a>
            </nav>
        </div>
        <div class="club-footer__legal">
            <span>© @DateTime.Now.Year TSV 1883 Bogen e.V.</span>
            <div><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a><a href="#top">Nach oben ↑</a></div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
